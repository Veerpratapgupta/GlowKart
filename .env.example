# GlowCart environment variables
# Copy this file to .env.local and fill in values as features are implemented.
# Never commit real values. Phase 0 runs with no variables set.

# Reserved for Phase 2+ (YouCam Skin AI). Not required for Phase 0.
# YOUCAM_API_BASE_URL=
# YOUCAM_AUTHORIZATION=  # full server-only Authorization value from YouCam
# YOUCAM_API_KEY=        # legacy fallback key name (kept for compatibility)

# recorded (default) is safe for judges; live stays disabled until the official
# upload contract is verified in the application adapter.
# GLOWCART_ANALYSIS_MODE=recorded

# Required alongside live mode. Set only on a separately protected deployment.
# GLOWCART_LIVE_DEPLOYMENT=protected
